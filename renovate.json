{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": ["dependencies", "security", "automated-patch"],
  "kubernetes": {
    "fileMatch": ["apps/.+\\.ya?ml$", "raw-manifests/.+\\.ya?ml$"]
  },
  "helm-values": {
    "fileMatch": ["chart-values/.+\\.ya?ml$"]
  },
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": false
    },
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update", "manual-review"]
    }
  ]
}
